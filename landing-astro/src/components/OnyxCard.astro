---
// Recovered from the original Onyx Astro port at 50d8ecef.
interface Props {
  idx: string;
  serial: string;
  kicker: string;
  footL: string;
  footR: string;
  heading: string;
}
const { idx, serial, kicker, footL, footR, heading } = Astro.props;
---

<section class="onyx-screen" aria-labelledby={heading} style="--mx:50%;--my:50%">
  <div class="onyx-screen-sheen" aria-hidden="true"></div>
  <div class="onyx-screen-foil" aria-hidden="true"></div>
  <div class="onyx-screen-corner tl" aria-hidden="true">◆</div>
  <div class="onyx-screen-corner tr" aria-hidden="true">◆</div>
  <div class="onyx-screen-corner bl" aria-hidden="true">◆</div>
  <div class="onyx-screen-corner br" aria-hidden="true">◆</div>
  <header class="onyx-screen-head">
    <a class="onyx-screen-mark" href="/" aria-label="Karte home">
      <span class="onyx-screen-diamond" aria-hidden="true">◆</span>
      <span class="onyx-screen-brand">Karte</span>
    </a>
    <div class="onyx-screen-kicker">{kicker}</div>
    <div class="onyx-screen-serial">{serial}</div>
  </header>
  <div class="onyx-screen-body"><slot /></div>
  <footer class="onyx-screen-foot">
    <span>{footL}</span><span class="onyx-screen-rule" aria-hidden="true"></span><span>{footR}</span>
  </footer>
  <div class="onyx-screen-idx" aria-hidden="true">card {idx} / vi</div>
</section>

<script>
  // Keep the original cursor-following foil without a React hydration graph.
  const motion = matchMedia('(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)');
  document.querySelectorAll<HTMLElement>('.onyx-screen').forEach((card) => {
    let frame = 0;
    let x = 50;
    let y = 50;
    card.addEventListener('pointermove', (event) => {
      if (!motion.matches) return;
      const bounds = card.getBoundingClientRect();
      x = ((event.clientX - bounds.left) / bounds.width) * 100;
      y = ((event.clientY - bounds.top) / bounds.height) * 100;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        card.style.setProperty('--mx', `${x}%`);
        card.style.setProperty('--my', `${y}%`);
        frame = 0;
      });
    });
  });
</script>
