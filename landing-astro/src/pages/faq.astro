---
import { faqCopy } from '../../../content-pages/public-editorial.mjs';
import Layout from '@/layouts/Layout.astro';
import ProductFooter from '@/components/ProductFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { faqs, product } from '@/lib/product';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<Layout
  hasProductFooter
  title="Karte FAQ — Profiles, inbound, access, and company scope"
  description="Straight answers about Karte public profiles, visitor chat, owner access, current cost, agent pages, and the not-yet-shipped company workflow."
  canonicalPath="/faq"
>
  <main class="karte-page">
    <SiteHeader current="faq" />
    <section class="faq-page" aria-labelledby="faq-title">
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
      <div class="section-heading">
        <p class="section-label">{faqCopy.eyebrow}</p>
        <h1 id="faq-title">{faqCopy.title} <em>{faqCopy.emphasis}</em></h1>
        <p>{product.purpose} {faqCopy.conclusion}</p>
      </div>
      <dl class="faq-ledger">
        {faqs.map((faq, index) => (
          <div>
            <dt><span>{String(index + 1).padStart(2, '0')}</span>{faq.question}</dt>
            <dd>{faq.answer}</dd>
          </div>
        ))}
      </dl>
      <div class="faq-action">
        <a class="onyx-btn-primary" href={faqCopy.primary.href}>{faqCopy.primary.label} <span aria-hidden="true">→</span></a>
        <a href={faqCopy.secondary.href}>{faqCopy.secondary.label}</a>
      </div>
    </section>
    <ProductFooter />
  </main>
</Layout>
