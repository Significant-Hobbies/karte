---
import Base from '@saas-maker/templates/Base.astro';
import { GalleryPage } from '@saas-maker/templates/gallery-page';
import { baseProps } from '@saas-maker/templates/page';
import { galleryContent } from '@saas-maker/templates/schema';
import json from '../content/home.json';

const content = galleryContent.parse(json);
// v0.1.13 validates absolute form URLs; submit to this origin's /create.
if (content.closing.form) content.closing.form.action = new URL(content.closing.form.action).pathname;
---

<Base {...baseProps(content)}>
  <Fragment slot="head">
    <meta name="application-name" content="Karte" />
    <meta name="theme-color" content="#0a0805" />
    <meta name="keywords" content="inbound assistant, link in bio, personal website, digital card, Carrd alternative, Own.page alternative, Linktree alternative" />
    <link rel="alternate" type="text/markdown" href="https://karte.cc/index.md" />
    <link rel="alternate" type="text/plain" href="https://karte.cc/llms.txt" />
    <script
      is:inline
      async
      src="https://www.clarity.ms/tag/y6bv15rm1t"
      onload="window.clarity('set', 'project_id', 'karte')"
    ></script>
    {/* Template links have no attribute field. Tag the same destinations before
        the unchanged App Health bridge handles clicks and flushes navigation. */}
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('a[href="/create"], a[href="/sarthak"], [data-identity-form] [type="submit"]').forEach((link) => {
          link.setAttribute('data-app-health-event', link.getAttribute('href') === '/sarthak'
            ? 'live_profile_opened'
            : 'page_creation_opened');
        });
      });
    </script>
    <script is:inline src="/app-health-log.js" defer></script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_479f6271328580806dd8b901f129ffd06726daf26cf537832bdbd943290744ff"
      data-project="app-731a1d3c-2eff-4ee8-aa6f-eaef1daaa7bf"
      data-identity="persistent"
      data-endpoint="https://ingest.sassmaker.com/v1/browser"
      data-vitals
      data-vitals-routes="ai-link-in-bio,articles,changelog,faq"
    ></script>
  </Fragment>
  <GalleryPage content={content} />
</Base>
