---
// Self-hosted variable fonts. Astro inlines the @font-face into the
// page's CSS via Lightning CSS (build.inlineStylesheets: 'always'),
// so we drop the external fonts.googleapis.com round-trip from the
// LCP path. Family names register as 'Playfair Display Variable' and
// 'Inter Variable' — mapped onto the existing --font-* CSS vars below
// so landing.css needs no changes. Playfair italic is required by
// the deck (.onyx-screen-title, .onyx-quote, etc.).
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/inter';
import playfairNormalUrl from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import playfairItalicUrl from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-italic.woff2?url';
import interNormalUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@/styles/landing.css';
import { SITE_ORIGIN, staticPublicRoute } from '../../../public-route-contract.mjs';
import { product } from '@/lib/product';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = '/' } = Astro.props;

const route = staticPublicRoute(canonicalPath);
const resolvedTitle = route?.title ?? title;
const resolvedDescription = route?.description ?? description;
const canonicalUrl = new URL(canonicalPath, SITE_ORIGIN);
// OG/Twitter image lives on the Next.js Worker at /opengraph-image
// (Next file convention → dynamic JSX → PNG). Astro can't trivially
// reproduce that. Post-cutover Pages takes `/` and Workers keeps every
// other route, so this URL still resolves. See README → cutover notes.
const OG_IMAGE = `${SITE_ORIGIN}/opengraph-image`;
const markdownPath = canonicalPath === '/' ? '/index.md' : `${canonicalPath}.md`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="application-name" content="Karte" />
    <meta name="theme-color" content="#0a0805" />

    <link rel="preload" href={playfairNormalUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfairItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interNormalUrl} as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/markdown" href={new URL(markdownPath, SITE_ORIGIN)} />
    <link rel="alternate" type="text/plain" href={new URL('/llms.txt', SITE_ORIGIN)} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Karte" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:image" content={OG_IMAGE} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <meta name="keywords" content="inbound assistant, link in bio, personal website, digital card, Carrd alternative, Own.page alternative, Linktree alternative" />

    {/* SoftwareApplication structured data — helps search engines
        understand Karte is a free web app built by Sarthak Agrawal. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Karte',
      applicationCategory: 'WebApplication',
      operatingSystem: 'Web Browser',
      url: 'https://karte.cc',
      description: product.description,
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        description: 'No billing is implemented in the current product; future pricing is not committed.',
      },
      creator: {
        '@type': 'Person',
        name: 'Sarthak Agrawal',
        url: 'https://sarthakagrawal.dev',
      },
    })} />

    {/* Wire the same CSS vars Next.js's next/font set up, so landing.css
       (which references var(--font-playfair) / var(--font-inter)) keeps
       working without changes. Fontsource Variable registers families
       as 'Playfair Display Variable' / 'Inter Variable', with the
       plain names left in the fallback chain so any cached non-variable
       face still hits before the system fallback. Geist/Instrument
       Serif/JetBrains were never loaded on this surface — kept as
       fallback-only var values to match the original Next.js layout. */}
    <style is:inline>
      :root {
        --font-playfair: 'Playfair Display Variable', 'Playfair Display', Georgia, 'Times New Roman', serif;
        --font-inter: 'Inter Variable', 'Inter', system-ui, -apple-system, sans-serif;
        --font-instrument-serif: 'Instrument Serif', Georgia, serif;
        --font-geist-sans: 'Geist', system-ui, sans-serif;
        --font-geist-mono: 'Geist Mono', ui-monospace, monospace;
        --font-jetbrains: 'JetBrains Mono', ui-monospace, monospace;
      }
      html.dark { color-scheme: dark; }
      body { margin: 0; }
      portfolio-project-strip,
      ai-chat-footer { display: block; }
      portfolio-project-strip { min-height: 2.875rem; }
      ai-chat-footer { min-height: 6rem; }
      @media (max-width: 1000px) {
        ai-chat-footer { min-height: 9rem; }
      }
    </style>
    <script
      is:inline
      async
      src="https://www.clarity.ms/tag/y6bv15rm1t"
      onload="window.clarity('set', 'project_id', 'karte')"
    ></script>
    <script is:inline src="/app-health-log.js" defer></script>
  </head>
  <body class="antialiased">
    <slot />
    <portfolio-project-strip current-project="karte"></portfolio-project-strip>
    <ai-chat-footer product-name="Karte"></ai-chat-footer>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project="karte"
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js"
      data-name="Karte"
      defer
    ></script>
  </body>
</html>
