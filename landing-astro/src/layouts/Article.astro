---
import { ARTICLE_AUTHOR, articleDisplayMeta } from '../../../content-pages/public-editorial.mjs';
import Layout from '@/layouts/Layout.astro';
import ProductFooter from '@/components/ProductFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';

const { frontmatter } = Astro.props;
const {
  title,
  description,
  date,
  author = ARTICLE_AUTHOR,
  readingMinutes,
} = frontmatter;

const meta = articleDisplayMeta({ date, author, readingMinutes });

---

<Layout
  hasProductFooter
  title={`${title} — Karte`}
  description={description}
  canonicalPath={Astro.url.pathname.replace(/\.html$/, '')}
>
  <main class="karte-page">
    <SiteHeader current="articles" />
    <article class="article-shell">
      <header class="article-header">
        <p class="changelog-kicker">Karte article</p>
        <h1>{title}</h1>
        <p class="article-description">{description}</p>
        {meta.length > 0 && <p class="article-meta">{meta.join(' · ')}</p>}
      </header>

      <div class="article-body">
        <slot />
      </div>

      <nav class="article-nav" aria-label="Article links">
        <a href="/articles">All articles →</a>
        <a href="/faq">FAQ →</a>
      </nav>
    </article>
    <ProductFooter />
  </main>
</Layout>
