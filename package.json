{
  "name": "linkchat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:agent": "node scripts/smoke-agent-api.mjs",
    "smoke:profile-memory": "node scripts/smoke-profile-memory.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "backfill:aggregates": "node scripts/backfill-aggregates.mjs",
    "enrich:profile": "node scripts/enrich-profile-from-links.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:build": "next build --webpack && node scripts/run-inline-critical-css.mjs && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare populateCache local && pnpm --filter ./landing-astro build && node scripts/run-overlay-astro-landing.mjs",
    "deploy:cf": "pnpm cf:build && opennextjs-cloudflare deploy --tag \"$(git rev-parse HEAD)\"",
    "upload:cf": "pnpm cf:build && opennextjs-cloudflare upload",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "docs:check": "node scripts/docs-check.mjs",
    "db:setup:local": "node scripts/setup-local-d1.mjs",
    "knip": "knip --no-exit-code --reporter symbols",
    "knip:strict": "knip --reporter symbols",
    "quality:unused": "node scripts/check-code-health.mjs unused",
    "quality:complexity": "node scripts/check-code-health.mjs complexity",
    "quality:duplication": "node scripts/check-code-health.mjs duplication",
    "quality:cycles": "node scripts/check-code-health.mjs cycles",
    "quality:dependencies": "node scripts/check-code-health.mjs dependencies",
    "quality:suppressions": "node scripts/check-code-health.mjs suppressions",
    "quality:hygiene": "node scripts/check-code-health.mjs hygiene",
    "quality": "pnpm check && pnpm typecheck && pnpm test:coverage && pnpm docs:check && pnpm --dir email-worker typecheck && pnpm quality:unused && pnpm quality:complexity && pnpm quality:duplication && pnpm quality:cycles && pnpm quality:dependencies && pnpm quality:suppressions && pnpm quality:hygiene"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@opennextjs/cloudflare": "1.20.2",
    "@types/sanitize-html": "^2.16.1",
    "ai": "6.0.168",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "html-to-image": "1.11.13",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "novel": "1.0.2",
    "posthog-js": "^1.407.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "beasties": "^0.3.5",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "jscpd": "5.0.14",
    "knip": "^6.29.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@10.33.2"
}
